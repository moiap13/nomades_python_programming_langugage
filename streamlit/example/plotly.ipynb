    "import plotly.express as px\n",
    "\n",
    "# Données d'exemple\n",
    "df = px.data.iris()\n",
    "\n",
    "# Créer un scatter plot\n",
    "fig = px.scatter(\n",
    "    df, x=\"sepal_width\", y=\"sepal_length\", color=\"species\", title=\"Iris Dataset\"\n",
    ")\n",
    "\n",
    "# Afficher dans Streamlit\n",
    "fig"
